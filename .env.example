# Copy to .env.local and fill in. Never commit real values.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used for webhooks, cron jobs and staff invites.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (voice agent + SMS reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public base URL Twilio should call back to (usually same as NEXT_PUBLIC_SITE_URL)
TWILIO_WEBHOOK_BASE_URL=http://localhost:3000

# Azure AI Speech, for the phone agent's voice (Twilio has no Georgian voice).
# Azure portal > Create "Speech service" > Keys and Endpoint. Required for
# Georgian calls; without it calls are answered in English.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Optional voice overrides (defaults shown). Georgian: ka-GE-EkaNeural (female)
# or ka-GE-GiorgiNeural (male).
AZURE_TTS_VOICE_KA=ka-GE-EkaNeural
AZURE_TTS_VOICE_EN=en-US-JennyNeural

# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Real business details shown on /contact and in Local Business structured data.
# Leave blank to hide; never put placeholder data here.
BUSINESS_LEGAL_NAME=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_STREET=
BUSINESS_CITY=
BUSINESS_REGION=
BUSINESS_POSTAL_CODE=
BUSINESS_COUNTRY=
